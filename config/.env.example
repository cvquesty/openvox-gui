# OpenVox GUI Configuration
# This file is auto-generated by install.sh — edit and restart to apply changes.
# All values can be overridden with OPENVOX_GUI_ prefix environment variables.

# Application
OPENVOX_GUI_APP_NAME="OpenVox GUI"
OPENVOX_GUI_APP_HOST=0.0.0.0
OPENVOX_GUI_APP_PORT=4567
OPENVOX_GUI_DEBUG=false
OPENVOX_GUI_SECRET_KEY=CHANGE_ME_GENERATE_WITH_python3_-c_"import_secrets;print(secrets.token_hex(32))"
# uvicorn process workers (systemd unit). 2 is a good default when this
# host also runs Puppet Server and PuppetDB. A dedicated console can go
# higher. See docs/PERFORMANCE.md.
# OPENVOX_GUI_UVICORN_WORKERS=2

# PuppetServer — catalog compile endpoint (compiler VIP in clustered estates).
# Used for environment_classes (ENC Common Classes), metrics, and agent-facing
# compile. Do NOT point this at a dedicated console host that does not compile.
OPENVOX_GUI_PUPPET_SERVER_HOST=compile.example.com
OPENVOX_GUI_PUPPET_SERVER_PORT=8140
# Clustered / dedicated console: global CA VIP (not the compiler LB).
# Empty: install.bash uses Settings → Cluster CA VIP FQDNs (fewest labels).
# Leave unset if the GUI runs on the same host as the CA (AIO).
# OPENVOX_GUI_PUPPET_CA_HOST=ovca.example.com
# OPENVOX_GUI_PUPPET_CA_PORT=8140
OPENVOX_GUI_PUPPET_SSL_CERT=/etc/puppetlabs/puppet/ssl/certs/puppet.example.com.pem
OPENVOX_GUI_PUPPET_SSL_KEY=/etc/puppetlabs/puppet/ssl/private_keys/puppet.example.com.pem
OPENVOX_GUI_PUPPET_SSL_CA=/etc/puppetlabs/puppet/ssl/certs/ca.pem
OPENVOX_GUI_PUPPET_CONFDIR=/etc/puppetlabs/puppet
OPENVOX_GUI_PUPPET_CODEDIR=/etc/puppetlabs/code

# PuppetDB (clustered read = DNS RR, e.g. ovdb.example.com — not ovdb1)
OPENVOX_GUI_PUPPETDB_HOST=puppetdb.example.com
OPENVOX_GUI_PUPPETDB_PORT=8081
# Other site OpenVoxDB VIPs so Overview / Needs attention match both consoles.
# OPENVOX_GUI_PUPPETDB_PEERS=ovdb.site-b.example.com
# Annotate stale Failed / any report (Needs attention). Does not rewrite badges.
# OPENVOX_GUI_FAILED_ALERT_HOURS=8
# OPENVOX_GUI_NODE_FRESH_HOURS=24

# Authentication (none | local)
OPENVOX_GUI_AUTH_BACKEND=local

# Database
# Shared Postgres is required for multi-console ENC (same classify answers):
# OPENVOX_GUI_DATABASE_URL=postgresql+asyncpg://openvox_gui:secret@db.example.com/openvox_gui
OPENVOX_GUI_DATABASE_URL=sqlite+aiosqlite:////opt/openvox-gui/data/openvox_gui.db

# ── ENC (compilers only — not read by the GUI process) ──────────
# Runtime: external_nodes = /usr/local/bin/enc.py
# OPENVOX_GUI_API_BASE for puppetserver lives in /etc/sysconfig/openvox-enc
# (EnvironmentFile), not in this GUI .env. See scripts/bootstrap-compiler-enc.sh.
# HTTPS verifies the GUI cert against the Puppet CA (3.12.0-rc.44+).
# OPENVOX_GUI_ENC_TLS_VERIFY=0 restores CERT_NONE.
